## Marketplace — marketplace.yuksalish.dev (HTTP only — SSL'ga keyin certbot o'tkazadi)

upstream marketplace_api {
    server 127.0.0.1:2400;
    keepalive 16;
}

upstream marketplace_webapp {
    server 127.0.0.1:2401;
    keepalive 16;
}

upstream marketplace_admin {
    server 127.0.0.1:2402;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name marketplace.yuksalish.dev;

    # File uploads cap
    client_max_body_size 20M;

    # Logs (alohida)
    access_log /var/log/nginx/marketplace.access.log;
    error_log /var/log/nginx/marketplace.error.log;

    # Telegram webhook (no /api prefix, no rewrites)
    location /telegram/ {
        proxy_pass http://marketplace_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # API
    location /api/ {
        proxy_pass http://marketplace_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 30s;
        proxy_read_timeout 60s;
    }

    # File uploads (sharp orqali optimized images)
    location /uploads/ {
        proxy_pass http://marketplace_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_cache_valid 200 7d;
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
    }

    # Socket.IO (admin real-time)
    location /socket.io/ {
        proxy_pass http://marketplace_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    # Health (debugging)
    location = /health {
        proxy_pass http://marketplace_api/health;
        access_log off;
    }

    # Admin panel (basePath='/admin' bilan build qilingan)
    location /admin {
        proxy_pass http://marketplace_admin;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
    }

    # WebApp (default, hammasi)
    location / {
        proxy_pass http://marketplace_webapp;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
        # WebSocket support for Next.js HMR (dev only — not needed in prod but safe)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
