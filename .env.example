# Nusxa oling: cp .env.example .env  (yoki qo'lda .env yarating)

# Ma'lumotlar bazasi (SQLite)
DATABASE_URL="file:./dev.db"

# Sessiya maxfiy kaliti (kamida 32 belgi, tasodifiy) — MAJBURIY.
# Ishlab chiqarishda "dev-only-secret..." yoki 16 belgidan qisqa qiymat bilan
# auth ISHLAMAYDI (ataylab fail-closed: soxta sessiya yasashning oldini oladi).
# Yaratish:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# Admin sifatida belgilanadigan email. O'rnatilsa — AYNAN shu email bilan
# ro'yxatdan o'tgan foydalanuvchi ADMIN bo'ladi (poygasiz, deterministik).
# Bo'sh qoldirilsa — birinchi ro'yxatdan o'tgan foydalanuvchi admin bo'ladi.
ADMIN_EMAIL=""

# --- Provayderlar ---
# LZT Market (lzt.market) — Telegram akkauntlari (raqam + kirish kodi) va
# Telegram Premium gift havolalari. Kalit bo'lsa Telegram va Premium AYNAN
# shu yerdan olinadi (eng arzon). DIQQAT: LZT xaridi qaytmaydi — bu
# buyurtmalarni bekor qilib/pulni qaytarib bo'lmaydi.
# Token: lzt.market -> Sozlamalar -> API (scope: market).
LZT_API_KEY=""
LZT_BASE_URL="https://prod-api.lzt.market"
# LZT narxlari RUB'da: 1 RUB necha so'm
RUB_TO_UZS="150"

# iStar (istar.fragmentapi.com) — Telegram STARS (Fragment + ~5%).
# Panel: https://istar.fragmentapi.com/dashboard. Hamyon TON yoki USDT'da.
ISTAR_API_KEY=""
ISTAR_BASE_URL="https://v1.fragmentapi.com/api/v1/partner"
ISTAR_WALLET="TON"
# iStar Stars narxini API'da bermaydi — 1 star narxi (USD)
ISTAR_USD_PER_STAR="0.0158"

# SPIDER TG API — real SIM, Telegram uchun ISHLAYDI (Telegram uchun BIRINCHI).
SPIDER_API_KEY=""
SPIDER_BASE_URL="https://api.spider-service.com"

# HeroSMS (SMS-Activate protokoli) — WhatsApp/Instagram/Google va boshqa
# SMS xizmatlari uchun (Telegram LZT'da).
HEROSMS_API_KEY=""
HEROSMS_BASE_URL="https://hero-sms.com/stubs/handler_api.php"

# 5sim API kaliti (HeroSMS bo'sh bo'lsa ishlatiladi; ikkisi ham bo'sh = MOCK/demo)
FIVESIM_API_KEY=""
# 5sim bloklangan bo'lsa — mirror/proxy manzili
FIVESIM_BASE_URL="https://5sim.net/v1"

# Narx sozlamalari (5sim USD'da qaytaradi)
USD_TO_UZS="12000"
MARKUP_PERCENT="30"

# Ilova manzili (to'lov qaytish havolalari uchun)
APP_URL="http://localhost:3000"

# To'lov / balans to'ldirish
# DEMO to'ldirish sinov uchun darhol TEKIN balans qo'shadi.
# Ishlab chiqarishda default O'CHIQ; yoqish uchun ataylab "true" yozish kerak.
# Namunada ATAYLAB "false" — bu faylni prod'ga nusxalasangiz tekin balans
# teshigi ochilib qolmasin. Lokal ishlab chiqishda "true" qilishingiz mumkin.
DEMO_TOPUP="false"
MIN_TOPUP="1000"
MAX_TOPUP="10000000"

# --- Payme / Click ---
# DIQQAT: bu usullar faqat merchant CALLBACK endpointi yozilgandan keyin
# yoqilishi kerak. Callback bo'lmasa mijoz pul to'laydi-yu, balansi OSHMAYDI.
# Shuning uchun merchant ma'lumotlari to'ldirilsa ham, quyidagi *_CALLBACKS_READY
# "true" bo'lmaguncha usul foydalanuvchiga ko'rsatilmaydi.
PAYME_MERCHANT_ID=""
PAYME_KEY=""
PAYME_CALLBACKS_READY="false"

CLICK_MERCHANT_ID=""
CLICK_SERVICE_ID=""
CLICK_SECRET_KEY=""
CLICK_CALLBACKS_READY="false"

# --- Seed (prisma db seed) ---
# Admin parol. Ishlab chiqarishda MAJBURIY (aks holda seed to'xtaydi).
# Dev'da bo'sh qoldirilsa — tasodifiy kuchli parol yaratilib konsolga chiqadi.
SEED_ADMIN_EMAIL="admin@vega.uz"
SEED_ADMIN_PASSWORD=""
