# Production .env namuna — selliostore.uz uchun
# Bu faylni `.env`'ga ko'chiring va real qiymatlar bilan to'ldiring

NODE_ENV=production
PORT=2400

# Postgres (production server)
DATABASE_URL=postgresql://marketplace:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:5432/marketplace?schema=public

# Redis (production server)
REDIS_URL=redis://127.0.0.1:6379

# Admin JWT (32+ chars, har xil!)
JWT_ACCESS_SECRET=CHANGE_ME_super_random_32_chars_min_xyz
JWT_REFRESH_SECRET=CHANGE_ME_different_random_32_chars_min_abc
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Super Admin JWT (alohida secretlar)
SUPER_JWT_ACCESS_SECRET=CHANGE_ME_super_admin_access_secret_32chars
SUPER_JWT_REFRESH_SECRET=CHANGE_ME_super_admin_refresh_secret_32chars
SUPER_JWT_ACCESS_TTL=15m
SUPER_JWT_REFRESH_TTL=7d

# Telegram bot (BotFather'dan oling)
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN
TELEGRAM_BOT_USERNAME=selliostore_bot
TELEGRAM_ORDERS_CHANNEL_ID=-1000000000000
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME_webhook_secret
TELEGRAM_USE_WEBHOOK=true

# Uploads
UPLOAD_DIR=/opt/marketplace/uploads
UPLOAD_MAX_SIZE_MB=10
PUBLIC_UPLOADS_URL=https://selliostore.uz/uploads

# Admin seed
ADMIN_SEED_EMAIL=admin@selliostore.uz
ADMIN_SEED_PASSWORD=CHANGE_ME_strong_password
ADMIN_SEED_FULLNAME=Sellio Admin

# Super Admin seed
SUPER_SEED_EMAIL=owner@selliostore.uz
SUPER_SEED_PASSWORD=CHANGE_ME_super_owner_password
SUPER_SEED_FULLNAME=Sellio Owner
SUPER_SEED_DEMO=0

# ═══════════════════════════════════════════════════════════
# DOMENLAR (production)
# ═══════════════════════════════════════════════════════════
APP_URL=https://selliostore.uz
WEBAPP_URL=https://clients.selliostore.uz
ADMIN_URL=https://admin.selliostore.uz
SUPERADMIN_URL=https://dev.selliostore.uz
LANDING_URL=https://selliostore.uz

# Business defaults
MIN_ORDER_AMOUNT=30000
DELIVERY_FEE=25000
FREE_DELIVERY_THRESHOLD=500000
DEFAULT_CURRENCY=UZS

# Analytics
EVENTS_RETENTION_DAYS=90
WEEKLY_AGGREGATION_CRON=0 3 * * 1
