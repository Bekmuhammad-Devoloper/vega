# ═══════════════════════════════════════════════════════════════════
# Backend .env namunasi — `.env` ga ko'chirib, haqiqiy qiymatlar bilan
# to'ldiring. Hech qachon `.env` ni git'ga commit qilmang.
# ═══════════════════════════════════════════════════════════════════

# Server
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
WEBAPP_URL=http://localhost:5174
ADMIN_URL=http://localhost:5175
SUPERADMIN_URL=http://localhost:5180
LANDING_URL=http://localhost:5173
# Bot /admin tugmasi shu URL ga ochadi. Bo'sh bo'lsa APP_URL + /admin/login ishlatiladi.
ADMIN_PANEL_URL=

# Database
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/marketplace
REDIS_URL=redis://localhost:6379

# Admin JWT (32+ baytli tasodifiy stringlar — har xil!)
# Yaratish: openssl rand -base64 48 | tr -d '/+=' | head -c 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Super Admin JWT (alohida secret'lar)
SUPER_JWT_ACCESS_SECRET=
SUPER_JWT_REFRESH_SECRET=
SUPER_JWT_ACCESS_TTL=15m
SUPER_JWT_REFRESH_TTL=7d

# Telegram (BotFather → /newbot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ORDERS_CHANNEL_ID=
TELEGRAM_SUPPORT_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_USE_WEBHOOK=false

# Upload
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE_MB=5
PUBLIC_UPLOADS_URL=http://localhost:4000/uploads

# Admin seed (birinchi ishga tushirishda yaratiladi)
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=
ADMIN_SEED_FULLNAME=Super Admin

# Super Admin seed
SUPER_SEED_EMAIL=owner@example.com
SUPER_SEED_PASSWORD=
SUPER_SEED_FULLNAME=Platform Owner
SUPER_SEED_DEMO=0

# Business defaults (admin UI'dan ham tahrirlanadi)
MIN_ORDER_AMOUNT=30000
DELIVERY_FEE=25000
FREE_DELIVERY_THRESHOLD=500000
DEFAULT_CURRENCY=UZS

# Analytics
EVENTS_RETENTION_DAYS=14
WEEKLY_AGGREGATION_CRON=0 3 * * 1

# ─── Pulli tarif: qo'lda karta to'lov ko'rsatkichi ─────────────────
# Bu qiymatlar foydalanuvchiga "qo'lda to'lov" sahifasida ko'rsatiladi.
# Hech bo'lmaganda bitta karta to'ldirilmasa, qo'lda to'lov ko'rinmaydi.
PAYMENT_CARD_HUMO=
PAYMENT_CARD_VISA=
PAYMENT_CARD_HOLDER=
PAYMENT_CONFIRM_CHANNEL_URL=
PAYMENT_CONFIRM_NOTE=
