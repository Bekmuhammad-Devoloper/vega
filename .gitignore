# ═══════════════════════════════════════════════════════════════════
# Hech qachon git'ga tushmasin: secret'lar, mahalliy build artefaktlari,
# yuklangan fayllar, OS chiqindilari.
# ═══════════════════════════════════════════════════════════════════

# ─── Sirlar va credential'lar ──────────────────────────────────────
# Barcha .env variantlari — faqat *.example va *.sample ruxsat
.env
.env.*
**/.env
**/.env.*
!.env.example
!.env.sample
!**/.env.example
!**/.env*.example
!**/.env.sample

# Maxsus secret fayllari
secrets/
**/secrets/
secret.*
secrets.*
*.secret
credentials.json
credentials.*.json
service-account*.json
service_account*.json
*-service-account.json
sa-key*.json
gcp-key*.json
firebase-adminsdk*.json

# Kalitlar va sertifikatlar
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.der
*.asc
*.ppk
*.jks
*.keystore

# SSH private kalitlar (har xil shaklda)
**/id_rsa
**/id_rsa.*
**/id_ed25519
**/id_ed25519.*
**/id_dsa
**/id_dsa.*
**/id_ecdsa
**/id_ecdsa.*
**/*_rsa
**/*_ed25519
**/*_dsa
**/*_ecdsa
**/known_hosts
**/authorized_keys
**/yuksalish_deploy*
:USERPROFILE*

# Cloud SDK credential cache'lari
.gcloud/
.aws/
.azure/
.config/gcloud/

# ─── Build va dependency artefaktlari ─────────────────────────────
node_modules
**/node_modules
dist
**/dist
build
out
.next
**/.next
.nuxt
.cache
.turbo
.parcel-cache
.svelte-kit
coverage
*.tsbuildinfo
**/*.tsbuildinfo

# ─── Loglar va vaqtinchalik fayllar ───────────────────────────────
*.log
logs/
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.pid
*.seed
*.pid.lock
*.tgz

# ─── Foydalanuvchi yuklagan kontent ───────────────────────────────
/uploads/
**/uploads/
public/uploads/
backups/

# ─── IDE va OS chiqindilari ───────────────────────────────────────
.vscode/
.idea/
*.iml
*.swp
*.swo
*~
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
.claude/

# ─── Test va vaqtinchalik chiqishlar ──────────────────────────────
.nyc_output/
.jest-cache/
.eslintcache
*.tmp
*.temp
.tmp/
tmp/
temp/
.tunnel-url

# ─── Backup / eski nusxalar (tasodifan saqlanmasin) ───────────────
**/.env.OLD*
**/.env.BAK*
**/.env.bak*
**/.env.backup*
**/*.OLD.*

# ─── Lokal sozlash skriptlari (yashirin qiymatlar bo'lishi mumkin) ─
setup-cicd.ps1
setup-ssh.ps1
fix-ssh.ps1
deploy/_ssh.bat
deploy/ssh.ps1
deploy/.env*
deploy/secrets*
